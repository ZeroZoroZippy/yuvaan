{
  "devCommand": "cd client && npm start",
  "buildCommand": "cd client && npm install && CI=false npm run build",
  "outputDirectory": "client/build",
  "framework": "create-react-app",
  "functions": {
    "api/contact.js": { "maxDuration": 10 },
    "api/leads.js": { "maxDuration": 10 },
    "api/unknown-questions.js": { "maxDuration": 10 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
